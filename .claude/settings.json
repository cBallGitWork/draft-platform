{
  "permissions": {
    "deny": [
      "Read(./.env*)",
      "Bash(vercel --prod*)",
      "Bash(vercel * --prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel rollback*)",
      "Bash(npx vercel --prod*)",
      "Bash(npx vercel * --prod*)",
      "Bash(npx vercel promote*)",
      "mcp__84f42f52-2732-4528-ab6f-b9eb615d85ea__create_deployment",
      "mcp__84f42f52-2732-4528-ab6f-b9eb615d85ea__request_promote",
      "mcp__84f42f52-2732-4528-ab6f-b9eb615d85ea__request_rollback",
      "mcp__84f42f52-2732-4528-ab6f-b9eb615d85ea__assign_alias"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup_current.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quick_check.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_github.py",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|mcp__ccd_turn__wrap_up",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_ask.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_mode.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage|mcp__ccd_session__.*|mcp__ccd_session_mgmt__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_sessions.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/line_ceiling.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/words_voice.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_ask.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/context_size.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/last_prompt.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/quick_check.py",
            "timeout": 90,
            "statusMessage": "Running the quick checks"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "forge": {
      "source": {
        "source": "github",
        "repo": "cBallGitWork/forge"
      }
    }
  },
  "enabledPlugins": {
    "forge@forge": true
  }
}
