    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "convex-test": "^0.0.62",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
