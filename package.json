{
  "name": "draft-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "convex login && convex dev --once --configure existing --team craigdavidball14 --project draft-platform --dev-deployment cloud",
    "setup:live": "node scripts/live-setup.mjs",
    "dev": "convex dev --start vite",
    "build": "vite build && node scripts/bundle-has-no-preview.mjs",
    "test": "node scripts/with-deadline.mjs 300 vitest run",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p .",
    "smoke": "playwright test",
    "coverage": "node scripts/with-deadline.mjs 600 vitest run --coverage --testTimeout=30000",
    "verify": "npm ls --depth=0 >/dev/null 2>&1 || { echo 'node_modules is behind package-lock.json: run npm ci'; exit 1; } && npm test && npm run typecheck && node scripts/recorded-add-only.mjs && node scripts/spec-ids.mjs && .claude/hooks/test.sh"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@fontsource/archivo-narrow": "^5.3.0",
    "@tanstack/react-router": "^1.170.45",
    "convex": "^1.47.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "convex-test": "^0.0.62",
    "esbuild": "0.27.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "63.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
