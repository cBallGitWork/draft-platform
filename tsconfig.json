{
  // The app in src/. Convex's functions have their own, convex/tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The app imports convex/_generated/api, whose types reach into convex/, so process.d.ts too.
  "include": ["src", "vite.config.ts", "vitest.config.ts", "convex/process.d.ts"]
}
