{
  // The app in src/ and every test in tests/. Convex's functions have their own,
  // convex/tsconfig.json, which sees only convex/, so Convex never bundles a test.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    /* For the tests' recorded payloads in tests/support/recorded. */
    "resolveJsonModule": true,
    "noEmit": true
  },
  // The app imports convex/_generated/api, whose types reach into convex/, so process.d.ts too.
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "convex/process.d.ts"]
}
